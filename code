            // Timecode timer loop
            clearInterval(state.playbackInterval);
            state.playbackInterval = setInterval(() => {
                if (state.currentTime < vm.duration) {
                    state.currentTime += 1;
                    updateScrubberUI();
                } else {
                    stopAudio();
                    checkGameProgress();
                }
            }, 1000 / state.playbackSpeed);

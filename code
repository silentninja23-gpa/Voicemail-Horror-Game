        // Play procedural tape mechanical noise
        function playTapeClick() {
            if (!state.audioContext) return;
            const ctx = state.audioContext;
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();

            osc.type = 'triangle';
            osc.frequency.setValueAtTime(120, ctx.currentTime);
            osc.frequency.exponentialRampToValueAtTime(30, ctx.currentTime + 0.08);

            gain.gain.setValueAtTime(0.3 * state.sfxVolume * state.masterVolume, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.08);

            osc.connect(gain);
            gain.connect(ctx.destination);

            osc.start();
            osc.stop(ctx.currentTime + 0.08);
        }

        // Play procedural tape static hiss hum
        let hissNode = null;
        function startTapeHiss() {
            if (!state.audioContext || hissNode) return;
            const ctx = state.audioContext;
            const bufferSize = ctx.sampleRate * 2;
            const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
            const output = buffer.getChannelData(0);

            for (let i = 0; i < bufferSize; i++) {
                output[i] = (Math.random() * 2 - 1) * 0.015; // Soft ambient white noise
            }

            hissNode = ctx.createBufferSource();
            hissNode.buffer = buffer;
            hissNode.loop = true;

            const filter = ctx.createBiquadFilter();
            filter.type = 'lowpass';
            filter.frequency.value = state.filterEnabled ? 800 : 2500; // Filter adjustment

            const gain = ctx.createGain();
            gain.gain.value = 0.15 * state.sfxVolume * state.masterVolume;

            hissNode.connect(filter);
            filter.connect(gain);
            gain.connect(ctx.destination);

            hissNode.start();
        }

        function stopTapeHiss() {
            if (hissNode) {
                try { hissNode.stop(); } catch(e){}
                hissNode = null;
            }
        }

        // Speech Synthesis Engine with custom pitch & filters
        let currentUtterance = null;
        function speakTranscript(textList, pitch, rate, isReverseMode = false) {
            if (!('speechSynthesis' in window)) return;

            window.speechSynthesis.cancel(); // Stop ongoing speech

            const fullText = isReverseMode ? textList.join('. ').split('').reverse().join('') : textList.join('. ');
            
            currentUtterance = new SpeechSynthesisUtterance(fullText);
            currentUtterance.pitch = (pitch || 1.0) * state.voicePitchMod;
            currentUtterance.rate = (rate || 1.0) * state.playbackSpeed;

            // Attempt to select eerie voices if available
            const voices = window.speechSynthesis.getVoices();
            if (voices.length > 0) {
                // Pick pitch-appropriate voice
                if (pitch < 0.8 && voices.find(v => v.name.includes('Male') || v.name.includes('David'))) {
                    currentUtterance.voice = voices.find(v => v.name.includes('Male') || v.name.includes('David'));
                } else if (pitch > 1.1 && voices.find(v => v.name.includes('Female') || v.name.includes('Zira'))) {
                    currentUtterance.voice = voices.find(v => v.name.includes('Female') || v.name.includes('Zira'));
                }
            }

            window.speechSynthesis.speak(currentUtterance);
        }

        /* ===================================================================
           CANVAS WAVEFORM VISUALIZER
           =================================================================== */
        let canvas, canvasCtx;
        function setupCanvasVisualizer() {
            canvas = document.getElementById('waveform-canvas');
            if (!canvas) return;
            canvasCtx = canvas.getContext('2d');
            
            function render() {
                requestAnimationFrame(render);
                canvas.width = canvas.clientWidth;
                canvas.height = canvas.clientHeight;

                canvasCtx.clearRect(0, 0, canvas.width, canvas.height);

                if (state.isPlaying) {
                    canvasCtx.lineWidth = 2;
                    canvasCtx.strokeStyle = state.isReversed ? '#ff3344' : '#33ff66';
                    canvasCtx.beginPath();

                    const sliceWidth = canvas.width / 60;
                    let x = 0;

                    for (let i = 0; i < 60; i++) {
                        const v = Math.random() * (state.filterEnabled ? 0.3 : 0.8);
                        const y = (v * canvas.height) / 2 + canvas.height / 4;

                        if (i === 0) canvasCtx.moveTo(x, y);
                        else canvasCtx.lineTo(x, y);

                        x += sliceWidth;
                    }

                    canvasCtx.stroke();
                } else {
                    // Flatline idle state
                    canvasCtx.lineWidth = 1;
                    canvasCtx.strokeStyle = '#1e3a29';
                    canvasCtx.beginPath();
                    canvasCtx.moveTo(0, canvas.height / 2);
                    canvasCtx.lineTo(canvas.width, canvas.height / 2);
                    canvasCtx.stroke();
                }
            }
            render();
        }


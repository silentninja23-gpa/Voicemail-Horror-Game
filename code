            state.unlockedPasscode = false;
            state.hasTriggeredLiveCall = false;
            state.decryptedCount = 0;

            VOICEMAILS.forEach((vm, i) => {
                vm.unread = true;
                if (i >= 6) vm.locked = true;
            });

            document.getElementById('ending-modal').classList.add('hidden');
            document.getElementById('passcode-input').value = '';
            document.getElementById('keypad-status').innerText = 'LOCKED';
            document.getElementById('keypad-status').className = 'text-xs font-typewriter text-red-800 font-bold';

            renderVoicemailList();
            renderEvidenceNotes();
            stopAudio();
        }

        /* ===================================================================
           NAVIGATION & MODAL HELPERS
           =================================================================== */
        function switchTab(tabName) {
            playTapeClick();
            const tabNotebook = document.getElementById('tab-notebook');
            const tabTranscript = document.getElementById('tab-transcript');
            const btnNotebook = document.getElementById('tab-notebook-btn');
            const btnTranscript = document.getElementById('tab-transcript-btn');

            if (tabName === 'notebook') {
                tabNotebook.classList.remove('hidden');
                tabTranscript.classList.add('hidden');

                btnNotebook.classList.add('border-red-500', 'text-red-400');
                btnNotebook.classList.remove('border-transparent', 'text-gray-500');

                btnTranscript.classList.remove('border-red-500', 'text-red-400');
                btnTranscript.classList.add('border-transparent', 'text-gray-500');
            } else {
                tabNotebook.classList.add('hidden');
                tabTranscript.classList.remove('hidden');

                btnTranscript.classList.add('border-red-500', 'text-red-400');
                btnTranscript.classList.remove('border-transparent', 'text-gray-500');

                btnNotebook.classList.remove('border-red-500', 'text-red-400');
                btnNotebook.classList.add('border-transparent', 'text-gray-500');
            }
        }

        function toggleSettingsModal() {
            const modal = document.getElementById('settings-modal');
            modal.classList.toggle('hidden');
        }

        function updateVolumes() {
            state.masterVolume = parseFloat(document.getElementById('vol-master').value);
            state.sfxVolume = parseFloat(document.getElementById('vol-sfx').value);
            state.voicePitchMod = parseFloat(document.getElementById('voice-pitch-mod').value);

            document.getElementById('val-master').innerText = `${Math.round(state.masterVolume * 100)}%`;
            document.getElementById('val-sfx').innerText = `${Math.round(state.sfxVolume * 100)}%`;
        }

        // Initialize UI components on DOM load
        window.onload = function() {
            renderVoicemailList();
            renderEvidenceNotes();
            setupCanvasVisualizer();
        };
    </script>
</body>
</html>

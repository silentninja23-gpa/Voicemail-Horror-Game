                renderVoicemailList();
                renderEvidenceNotes();

                document.body.classList.add('glitching');
                setTimeout(() => document.body.classList.remove('glitching'), 500);

            } else {
                state.hearts--;
                playDamageSound();
                updateHeartsHUD();

                document.body.classList.add('glitching');
                setTimeout(() => document.body.classList.remove('glitching'), 300);

                if (state.hearts <= 0) {

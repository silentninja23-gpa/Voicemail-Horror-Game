<!DOCTYPE html>
<html lang="en" class="h-full select-none">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="theme-color" content="#060508">
    <title>New Voicemail - Mobile Horror App</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=VT323&family=Special+Elite&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'tape-dark': '#0b0a0e',
                        'tape-panel': '#16151c',
                        'tape-border': '#2d2a36',
                        'crt-green': '#33ff66',
                        'crt-red': '#ff2233',
                        'crt-amber': '#ffb000',
                    },
                    fontFamily: {
                        retro: ['"VT323"', 'monospace'],
                        typewriter: ['"Special Elite"', 'cursive'],
                        sans: ['Inter', 'sans-serif']
                    }
                }
            }
        }
    </script>

    <style>
        /* Touch & Mobile Optimizations */
        html, body {
            touch-action: manipulation;
            overscroll-behavior: none;
            -webkit-tap-highlight-color: transparent;
            background-color: #060508;
            color: #d1d5db;
            height: 100%;
            overflow: hidden;
        }

        /* Safe Area Padding for Modern Smart Phones */
        .pb-safe {
            padding-bottom: env(safe-area-inset-bottom, 16px);
        }
        .pt-safe {
            padding-top: env(safe-area-inset-top, 12px);
        }

        /* Scanlines Overlay */
        .crt-overlay::before {
            content: " ";
            display: block;
            position: absolute;
            top: 0; left: 0; bottom: 0; right: 0;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.35) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.03), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.03));
            z-index: 30;
            background-size: 100% 4px, 6px 100%;
            pointer-events: none;
        }

        @keyframes glitch {
            0% { transform: translate(0) }
            20% { transform: translate(-4px, 4px) }
            40% { transform: translate(-4px, -4px) }
            60% { transform: translate(4px, 4px) }
            80% { transform: translate(4px, -4px) }
            100% { transform: translate(0) }
        }

        .glitching {
            animation: glitch 0.12s infinite;
        }

        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .spinning {
            animation: spin 3s linear infinite;
        }

        @keyframes flicker {
            0% { opacity: 0.95; }
            50% { opacity: 1; }
            52% { opacity: 0.88; }
            54% { opacity: 1; }
            80% { opacity: 0.94; }
            100% { opacity: 0.98; }
        }

        .crt-screen {
            animation: flicker 0.18s infinite;
            box-shadow: inset 0 0 15px rgba(0,0,0,0.85);
        }

        .notebook-bg {
            background: #d8cfc0;
            background-image: radial-gradient(#b8a892 1px, transparent 0);
            background-size: 16px 16px;
            color: #1a1815;
        }

        .blackout-redacted {
            background-color: #0d0c0f;
            color: #0d0c0f;
            padding: 0 6px;
            border-radius: 2px;
            display: inline-block;
            user-select: none;
        }

        .heart-icon {
            transition: all 0.3s ease;
        }
        .heart-damaged {
            color: #3a2222 !important;
            transform: scale(0.8);
            filter: grayscale(1);
        }

        input[type=range] {
            accent-color: #ff2233;
            height: 12px;
        }

        /* Custom Scrollbars */
        ::-webkit-scrollbar {
            width: 4px;
        }
        ::-webkit-scrollbar-track {
            background: #0f0e13;
        }
        ::-webkit-scrollbar-thumb {
            background: #2a2734;
            border-radius: 2px;
        }
    </style>
</head>
<body class="font-sans h-full flex flex-col justify-between crt-overlay relative antialiased">

    <!-- MOBILE TAP-TO-POWER-ON OVERLAY (AUDIO UNLOCK) -->
    <div id="power-overlay" class="fixed inset-0 z-50 bg-black flex flex-col items-center justify-center p-6 text-center">
        <div class="w-20 h-20 bg-red-950/60 border-2 border-red-600 rounded-full flex items-center justify-center text-red-500 text-3xl mb-6 animate-pulse shadow-[0_0_30px_rgba(255,0,0,0.4)]">
            <i class="fa-solid fa-power-off"></i>
        </div>
        <h1 class="font-retro text-4xl text-red-500 tracking-wider mb-2">NEW VOICEMAIL</h1>
        <p class="font-typewriter text-xs text-gray-400 max-w-xs mb-8">System offline. Audio deck initialization required to process incoming message buffer.</p>
        
        <button onclick="powerOnSystem()" class="w-full max-w-xs py-4 bg-red-900 hover:bg-red-800 active:bg-red-950 text-white font-retro text-2xl rounded-xl border-2 border-red-500 shadow-lg active:scale-95 transition flex items-center justify-center gap-3">
            <i class="fa-solid fa-compact-disc"></i> TAP TO POWER ON
        </button>
    </div>

    <!-- MAIN APP HEADER -->
    <header class="pt-safe px-4 py-2 border-b border-tape-border bg-tape-dark shrink-0 flex justify-between items-center z-20">
        <div class="flex items-center gap-2.5">
            <div class="w-3 h-3 rounded-full bg-crt-red animate-pulse shadow-[0_0_8px_#ff2233]"></div>
            <div>
                <h1 class="text-xl font-retro text-red-500 tracking-wider leading-none">NEW VOICEMAIL</h1>
                <span class="text-[9px] text-gray-500 font-mono tracking-wider block">ANALOG TAPE DECK T-300</span>
            </div>
        </div>

        <!-- Sanity HUD -->
        <div class="flex items-center gap-2 bg-tape-panel px-3 py-1.5 rounded-lg border border-tape-border">
            <span class="text-[10px] font-mono text-gray-400 hidden sm:inline">SANITY:</span>
            <div id="hearts-container" class="flex gap-1.5 text-crt-red text-sm">
                <i id="heart-1" class="fa-solid fa-heart heart-icon"></i>
                <i id="heart-2" class="fa-solid fa-heart heart-icon"></i>
                <i id="heart-3" class="fa-solid fa-heart heart-icon"></i>
            </div>
        </div>
    </header>

    <!-- VIEW CONTAINERS / CONTENT (FLEX-1 SCROLLABLE) -->
    <main class="flex-1 relative overflow-hidden bg-tape-dark">
        
        <!-- SECTION 1: DECK VIEW -->
        <div id="view-deck" class="absolute inset-0 p-3 md:p-6 overflow-y-auto flex flex-col gap-3">
            
            <!-- Hardware Machine Body -->
            <div class="bg-tape-panel border border-tape-border rounded-xl p-3.5 shadow-xl flex flex-col justify-between gap-3">
                
                <!-- Cassette Header Window -->
                <div class="flex justify-between items-center bg-tape-dark p-2.5 rounded-lg border border-tape-border">
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-9 bg-black rounded border border-gray-800 flex items-center justify-around px-1 shadow-inner shrink-0">
                            <i id="reel-left" class="fa-solid fa-compact-disc text-gray-600 text-sm"></i>
                            <div class="w-2.5 h-0.5 bg-gray-700"></div>
                            <i id="reel-right" class="fa-solid fa-compact-disc text-gray-600 text-sm"></i>
                        </div>
                        <div class="min-w-0">
                            <div id="deck-status" class="font-retro text-crt-amber text-base leading-none">READY</div>
                            <div id="caller-id-display" class="text-[11px] text-gray-400 font-mono mt-1 truncate">SELECT A MESSAGE</div>
                        </div>
                    </div>

                    <!-- Counter Display -->
                    <div class="text-right shrink-0">
                        <div class="bg-black px-2.5 py-1 rounded border border-gray-800 font-retro text-xl text-crt-green tracking-widest crt-screen" id="tape-counter">
                            00:00
                        </div>
                    </div>
                </div>

                <!-- CRT Visualizer Canvas Screen -->
                <div class="relative bg-black rounded-lg border border-gray-800 p-2 min-h-[110px] h-28 flex flex-col justify-between overflow-hidden">
                    <canvas id="waveform-canvas" class="w-full h-full absolute inset-0 z-0 opacity-80"></canvas>
                    
                    <div class="relative z-10 flex justify-between text-[9px] font-mono text-gray-400 bg-black/60 px-2 py-0.5 rounded">
                        <span id="filter-status-text"><i class="fa-solid fa-sliders mr-1"></i> Tape Signal</span>
                        <span id="speed-status-text">1.0x Pitch</span>
                    </div>

                    <div id="transcript-overlay" class="relative z-10 text-center text-xs font-typewriter text-red-200 px-2 py-1 my-auto bg-black/60 rounded backdrop-blur-xs italic min-h-[38px] flex items-center justify-center">
                        "Select any voicemail from the inbox to begin..."
                    </div>

                    <div class="relative z-10 flex justify-between items-center text-[8px] font-mono text-gray-500 border-t border-gray-800/80 pt-0.5">
                        <span>SIGNAL: ANALOG</span>
                        <span id="secret-signal-indicator" class="text-red-500 hidden animate-pulse"><i class="fa-solid fa-triangle-exclamation"></i> REVERSE DETECTED</span>
                    </div>
                </div>

                <!-- Touch Audio Controls Scrub & Buttons -->
                <div class="space-y-3 bg-tape-dark p-3 rounded-lg border border-tape-border">
                    <div class="flex items-center gap-2">
                        <span id="current-time-text" class="font-retro text-xs text-gray-400 w-8">00:00</span>
                        <input type="range" id="scrubber" min="0" max="100" value="0" step="0.1" oninput="seekAudio(this.value)" class="w-full bg-gray-800 rounded-lg appearance-none cursor-pointer">
                        <span id="duration-text" class="font-retro text-xs text-gray-400 w-8 text-right">00:00</span>
                    </div>

                    <!-- Touch-Friendly Hardware Buttons (44px min height) -->
                    <div class="grid grid-cols-5 gap-2">
                        <button onclick="playPrevious()" class="h-12 bg-gray-800 active:bg-gray-900 text-gray-200 rounded-lg border border-gray-700 text-base flex items-center justify-center transition active:scale-95">
                            <i class="fa-solid fa-backward-step"></i>
                        </button>
                        <button id="play-btn" onclick="togglePlayPause()" class="h-12 bg-red-800 active:bg-red-950 text-white rounded-lg border border-red-600 font-bold col-span-2 flex items-center justify-center gap-2 transition active:scale-95">
                            <i class="fa-solid fa-play" id="play-icon"></i> <span id="play-btn-text" class="font-retro text-xl">PLAY</span>
                        </button>
                        <button onclick="stopAudio()" class="h-12 bg-gray-800 active:bg-gray-900 text-gray-200 rounded-lg border border-gray-700 text-base flex items-center justify-center transition active:scale-95">
                            <i class="fa-solid fa-square"></i>
                        </button>
                        <button onclick="playNext()" class="h-12 bg-gray-800 active:bg-gray-900 text-gray-200 rounded-lg border border-gray-700 text-base flex items-center justify-center transition active:scale-95">
                            <i class="fa-solid fa-forward-step"></i>
                        </button>
                    </div>

                    <!-- Quick Toggles (Min 44px hit height) -->
                    <div class="grid grid-cols-3 gap-2 pt-1.5 border-t border-gray-800 text-xs">
                        <button id="reverse-btn" onclick="toggleReverse()" class="h-11 bg-gray-900 border border-gray-700 text-gray-300 rounded-lg active:scale-95 transition flex items-center justify-center gap-1.5">
                            <i class="fa-solid fa-rotate-left text-sm"></i> <span>Reverse</span>
                        </button>
                        <button id="hiss-btn" onclick="toggleHiss()" class="h-11 bg-emerald-950 border border-emerald-700 text-emerald-300 rounded-lg active:scale-95 transition flex items-center justify-center gap-1.5">
                            <i class="fa-solid fa-radio text-sm"></i> <span id="hiss-text">Static: ON</span>
                        </button>
                        <select id="speed-select" onchange="changeSpeed(this.value)" class="h-11 bg-gray-900 border border-gray-700 text-gray-300 rounded-lg px-2 text-xs focus:outline-none focus:border-red-500">
                            <option value="0.5">0.5x Slow</option>
                            <option value="1.0" selected>1.0x Normal</option>
                            <option value="1.5">1.5x Fast</option>
                        </select>
                    </div>
                </div>

            </div>

        </div>

        <!-- SECTION 2: INBOX VIEW -->
        <div id="view-inbox" class="absolute inset-0 p-3 md:p-6 overflow-y-auto hidden flex flex-col gap-3">
            <div class="flex justify-between items-center bg-tape-panel p-3 rounded-lg border border-tape-border">
                <h2 class="font-retro text-2xl text-red-400 tracking-wider flex items-center gap-2">
                    <i class="fa-solid fa-inbox text-base"></i> MESSAGES (8)
                </h2>
                <span id="unread-count" class="text-xs bg-red-950 text-red-400 border border-red-800 px-2.5 py-1 rounded-full font-mono">8 UNREAD</span>
            </div>

            <!-- Scrollable Inbox List -->
            <div id="voicemail-list" class="space-y-2.5">
                <!-- Dynamically rendered -->
            </div>
        </div>

        <!-- SECTION 3: NOTEBOOK / EVIDENCE VIEW -->
        <div id="view-notebook" class="absolute inset-0 p-3 md:p-6 overflow-y-auto hidden flex flex-col justify-between gap-4">
            <div class="notebook-bg p-4 rounded-xl border border-amber-900/40 shadow-inner flex-1 flex flex-col justify-between">
                <div>
                    <div class="border-b-2 border-stone-400 pb-2 mb-3 flex justify-between items-center">
                        <h3 class="font-typewriter text-sm font-bold text-stone-900 uppercase">
                            Case File: Blackwood Incident
                        </h3>
                        <span class="text-[10px] font-typewriter text-stone-600">#8802</span>
                    </div>

                    <!-- Evidence Bullet Notes -->
                    <div id="evidence-notes-container" class="space-y-2.5 font-typewriter text-xs text-stone-900">
                        <p class="text-[11px] italic text-stone-600 border-b border-stone-300 pb-1">
                            Listen to voicemails in the Inbox to gather clues...
                        </p>
                        <div id="evidence-notes-list" class="space-y-2">
                            <!-- Rendered dynamically -->
                        </div>
                    </div>
                </div>

                <!-- Decryption Keypad Panel -->
                <div class="mt-4 pt-3 border-t-2 border-dashed border-stone-400">
                    <div class="flex items-center justify-between mb-2">
                        <label class="font-typewriter text-xs font-bold text-stone-900 uppercase flex items-center gap-1">
                            <i class="fa-solid fa-lock text-red-800"></i> Decrypt Files:
                        </label>
                        <span id="keypad-status" class="text-[11px] font-typewriter text-red-800 font-bold">3 HEARTS REMAINING</span>
                    </div>
                    
                    <div class="flex gap-2">
                        <input type="text" id="passcode-input" maxlength="4" inputmode="numeric" placeholder="4-DIGIT CODE" class="w-full h-12 bg-stone-200 border-2 border-stone-500 font-retro text-2xl text-stone-900 tracking-widest text-center uppercase focus:outline-none focus:border-red-800 rounded-lg">
                        <button onclick="attemptDecryption()" class="h-12 px-5 bg-stone-900 active:bg-red-900 text-stone-100 font-typewriter font-bold text-xs rounded-lg transition shrink-0 flex items-center gap-1.5">
                            <i class="fa-solid fa-key text-sm"></i> UNLOCK
                        </button>
                    </div>
                    <p class="text-[9px] font-typewriter text-stone-600 mt-1">Warning: Incorrect codes deplete sanity. 0 hearts severs connection.</p>
                </div>
            </div>
        </div>

    </main>

    <!-- MOBILE BOTTOM NAVIGATION TAB BAR (Min 44px hit boxes) -->
    <nav class="pb-safe bg-tape-panel border-t border-tape-border shrink-0 z-20">
        <div class="grid grid-cols-3 h-14">
            <button id="nav-deck-btn" onclick="switchTab('deck')" class="flex flex-col items-center justify-center text-red-400 font-retro text-lg border-t-2 border-red-500 transition active:scale-95">
                <i class="fa-solid fa-tape text-sm"></i>
                <span class="text-[10px] font-sans tracking-wide">DECK</span>
            </button>
            <button id="nav-inbox-btn" onclick="switchTab('inbox')" class="flex flex-col items-center justify-center text-gray-500 font-retro text-lg border-t-2 border-transparent transition active:scale-95">
                <i class="fa-solid fa-inbox text-sm"></i>
                <span class="text-[10px] font-sans tracking-wide">INBOX</span>
            </button>
            <button id="nav-notebook-btn" onclick="switchTab('notebook')" class="flex flex-col items-center justify-center text-gray-500 font-retro text-lg border-t-2 border-transparent transition active:scale-95">
                <i class="fa-solid fa-book-bookmark text-sm"></i>
                <span class="text-[10px] font-sans tracking-wide">NOTEBOOK</span>
            </button>
        </div>
    </nav>

    <!-- LIVE INCOMING CALL MODAL -->
    <div id="incoming-call-modal" class="hidden fixed inset-0 z-50 bg-black/90 backdrop-blur-md flex items-center justify-center p-4">
        <div class="max-w-sm w-full bg-tape-panel border-2 border-red-600 rounded-2xl p-6 text-center space-y-5 shadow-2xl relative overflow-hidden animate-pulse">
            <div class="w-16 h-16 bg-red-950 border-2 border-red-500 rounded-full flex items-center justify-center mx-auto text-red-500 text-2xl animate-bounce">
                <i class="fa-solid fa-phone-volume"></i>
            </div>
            
            <div>
                <h3 class="font-retro text-3xl text-red-500 tracking-wider">INCOMING LIVE CALL</h3>
                <p class="text-xs font-mono text-gray-300 mt-1">LINE 1: UNKNOWN ORIGIN</p>
            </div>

            <div class="space-y-2.5 pt-2">
                <button onclick="handleEndingChoice('answer')" class="w-full h-12 bg-red-800 active:bg-red-900 text-white font-retro text-xl rounded-xl border border-red-500 transition">
                    <i class="fa-solid fa-phone mr-2"></i> ANSWER LINE 1
                </button>
                <button onclick="handleEndingChoice('purge')" class="w-full h-12 bg-amber-950 active:bg-amber-900 text-amber-200 font-retro text-xl rounded-xl border border-amber-700 transition">
                    <i class="fa-solid fa-fire mr-2"></i> BURN CASSETTE TAPE
                </button>
                <button onclick="handleEndingChoice('ignore')" class="w-full h-12 bg-gray-900 active:bg-gray-800 text-gray-400 font-retro text-xl rounded-xl border border-gray-700 transition">
                    <i class="fa-solid fa-phone-slash mr-2"></i> IGNORE CALL
                </button>
            </div>
        </div>
    </div>

    <!-- GAME OVER / JUMPSCARE MODAL -->
    <div id="game-over-modal" class="hidden fixed inset-0 z-50 bg-black/95 flex items-center justify-center p-4 crt-screen">
        <div class="max-w-sm w-full bg-red-950/50 border-2 border-red-700 rounded-2xl p-6 text-center space-y-4 shadow-[0_0_50px_rgba(255,0,0,0.5)]">
            <div class="text-red-500 text-5xl animate-ping">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <h2 class="font-retro text-4xl text-red-500 tracking-widest">SANITY CRACKED</h2>
            <p class="font-typewriter text-xs text-red-200 leading-relaxed">
                3 incorrect passcode attempts corrupted your mental signal. The answering deck speaker whispers your secrets back to you...
            </p>
            <button onclick="restartGame()" class="w-full h-12 bg-red-900 active:bg-red-800 text-white font-retro text-2xl rounded-xl border border-red-500 transition">
                <i class="fa-solid fa-rotate-right mr-2"></i> RESTART INVESTIGATION
            </button>
        </div>
    </div>

    <!-- ENDING MODAL -->
    <div id="ending-modal" class="hidden fixed inset-0 z-50 bg-black/95 flex items-center justify-center p-4">
        <div class="max-w-md w-full bg-stone-900 border-2 border-red-800 rounded-2xl p-5 space-y-4 text-center relative overflow-y-auto max-h-[85vh]">
            <div id="ending-badge" class="inline-block px-3 py-1 bg-red-950 text-red-400 border border-red-800 font-mono text-[10px] rounded-full uppercase tracking-widest">
                ENDING UNLOCKED
            </div>

            <h2 id="ending-title" class="font-retro text-2xl text-red-500 tracking-wide">
                THE BLACKWOOD INHERITANCE
            </h2>

            <div id="ending-description" class="font-typewriter text-stone-300 leading-relaxed text-xs text-left space-y-2 bg-black/60 p-3.5 rounded-lg border border-stone-800">
                <!-- Ending injected here -->
            </div>

            <button onclick="restartGame()" class="w-full h-12 bg-red-900 active:bg-red-800 text-white font-retro text-2xl rounded-xl transition">
                <i class="fa-solid fa-rotate-right mr-2"></i> RESTART TAPE ARCHIVE
            </button>
        </div>
    </div>


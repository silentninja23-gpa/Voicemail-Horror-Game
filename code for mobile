            renderEvidenceNotes();

            document.getElementById('caller-id-display').innerText = `${vm.caller.toUpperCase()} (${vm.timestamp})`;
            document.getElementById('duration-text').innerText = `00:${vm.duration < 10 ? '0' : ''}${vm.duration}`;

            switchTab('deck');

        function selectVoicemail(index) {
            const vm = VOICEMAILS[index];
            if (vm.locked) {
                playTapeClick();
                document.getElementById('deck-status').innerText = 'ENCRYPTED';
                document.getElementById('deck-status').className = 'font-retro text-crt-red text-base leading-none';

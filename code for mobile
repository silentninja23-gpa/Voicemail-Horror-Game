        function playAudio() {
            if (state.currentVmIndex < 0) return;
            const vm = VOICEMAILS[state.currentVmIndex];

            state.isPlaying = true;
            playTapeClick();
            startTapeHiss();

            document.getElementById('deck-status').innerText = state.isReversed ? 'PLAYING (REV)' : 'PLAYING';
            document.getElementById('deck-status').className = 'font-retro text-crt-green text-base leading-none animate-pulse';
            document.getElementById('play-icon').className = 'fa-solid fa-pause';
            document.getElementById('play-btn-text').innerText = 'PAUSE';

            document.getElementById('reel-left').classList.add('spinning');
            document.getElementById('reel-right').classList.add('spinning');

            const linesToSpeak = (state.isReversed && vm.reverseTranscript) ? [vm.reverseTranscript] : vm.transcript;
            speakTranscript(linesToSpeak, vm.pitch, vm.rate, state.isReversed);

            if (state.isReversed && vm.hasReverseSecret) {
                document.getElementById('transcript-overlay').innerText = `"${vm.reverseTranscript}"`;
                document.getElementById('secret-signal-indicator').classList.remove('hidden');
            } else {
                document.getElementById('transcript-overlay').innerText = `"${linesToSpeak[0]}"`;
                document.getElementById('secret-signal-indicator').classList.add('hidden');
            }

            clearInterval(state.playbackInterval);
            state.playbackInterval = setInterval(() => {
                if (state.currentTime < vm.duration) {
                    state.currentTime += 1;
                    updateScrubberUI();
                } else {
                    stopAudio();
                    checkGameProgress();
                }
            }, 1000 / state.playbackSpeed);
        }

        function togglePlayPause() {
            if (state.currentVmIndex < 0) {
                selectVoicemail(0);
                return;
            }

            if (state.isPlaying) {
                pauseAudio();
            } else {
                playAudio();
            }
        }

        function pauseAudio() {
            state.isPlaying = false;
            playTapeClick();
            stopTapeHiss();
            if ('speechSynthesis' in window) window.speechSynthesis.pause();

            document.getElementById('deck-status').innerText = 'PAUSED';
            document.getElementById('deck-status').className = 'font-retro text-crt-amber text-base leading-none';
            document.getElementById('play-icon').className = 'fa-solid fa-play';
            document.getElementById('play-btn-text').innerText = 'PLAY';

            document.getElementById('reel-left').classList.remove('spinning');
            document.getElementById('reel-right').classList.remove('spinning');

            clearInterval(state.playbackInterval);
        }

        function stopAudio() {
            state.isPlaying = false;
            state.currentTime = 0;
            playTapeClick();
            stopTapeHiss();
            if ('speechSynthesis' in window) window.speechSynthesis.cancel();

            document.getElementById('deck-status').innerText = 'STOPPED';
            document.getElementById('deck-status').className = 'font-retro text-crt-amber text-base leading-none';
            document.getElementById('play-icon').className = 'fa-solid fa-play';
            document.getElementById('play-btn-text').innerText = 'PLAY';

            document.getElementById('reel-left').classList.remove('spinning');
            document.getElementById('reel-right').classList.remove('spinning');

            clearInterval(state.playbackInterval);
            updateScrubberUI();
        }

        function playNext() {
            if (state.currentVmIndex < VOICEMAILS.length - 1) {
                selectVoicemail(state.currentVmIndex + 1);
            }
        }

        function playPrevious() {
            if (state.currentVmIndex > 0) {
                selectVoicemail(state.currentVmIndex - 1);
            }
        }

        function seekAudio(val) {
            if (state.currentVmIndex < 0) return;
            const vm = VOICEMAILS[state.currentVmIndex];
            state.currentTime = Math.floor((val / 100) * vm.duration);
            updateScrubberUI();
        }

        function updateScrubberUI() {
            const vm = VOICEMAILS[state.currentVmIndex];
            const maxDuration = vm ? vm.duration : 100;
            const percentage = (state.currentTime / maxDuration) * 100;

            document.getElementById('scrubber').value = percentage;
            
            const mins = Math.floor(state.currentTime / 60);
            const secs = Math.floor(state.currentTime % 60);
            const formatted = `0${mins}:${secs < 10 ? '0' : ''}${secs}`;
            
            document.getElementById('current-time-text').innerText = formatted;
            document.getElementById('tape-counter').innerText = formatted;
        }


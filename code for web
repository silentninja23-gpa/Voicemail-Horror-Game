<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Voicemail - Audio Horror Game</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=VT323&family=Special+Elite&family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'tape-dark': '#0b0a0e',
                        'tape-panel': '#16151c',
                        'tape-border': '#2d2a36',
                        'crt-green': '#33ff66',
                        'crt-red': '#ff2233',
                        'crt-amber': '#ffb000',
                        'blood-red': '#770000',
                    },
                    fontFamily: {
                        retro: ['"VT323"', 'monospace'],
                        typewriter: ['"Special Elite"', 'cursive'],
                        sans: ['Inter', 'sans-serif']
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #060508;
            color: #d1d5db;
            user-select: none;
            overflow-x: hidden;
        }

        /* Scanlines Overlay */
        .crt-overlay::before {
            content: " ";
            display: block;
            position: absolute;
            top: 0; left: 0; bottom: 0; right: 0;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.3) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.03), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.03));
            z-index: 30;
            background-size: 100% 4px, 6px 100%;
            pointer-events: none;
        }

        /* Glitch Effect */
        @keyframes glitch {
            0% { transform: translate(0) }
            20% { transform: translate(-4px, 4px) }
            40% { transform: translate(-4px, -4px) }
            60% { transform: translate(4px, 4px) }
            80% { transform: translate(4px, -4px) }
            100% { transform: translate(0) }
        }

        .glitching {
            animation: glitch 0.12s infinite;
        }

        /* Tape Reels Spinning Animation */
        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .spinning {
            animation: spin 3s linear infinite;
        }

        /* CRT Screen Flicker */
        @keyframes flicker {
            0% { opacity: 0.96; }
            50% { opacity: 1; }
            52% { opacity: 0.89; }
            54% { opacity: 1; }
            80% { opacity: 0.95; }
            100% { opacity: 0.98; }
        }

        .crt-screen {
            animation: flicker 0.15s infinite;
            box-shadow: inset 0 0 15px rgba(0,0,0,0.85);
        }

        /* Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0f0e13;
        }
        ::-webkit-scrollbar-thumb {
            background: #2a2734;
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #444154;
        }

        /* Evidence Board Background */
        .notebook-bg {
            background: #d8cfc0;
            background-image: radial-gradient(#b8a892 1px, transparent 0);
            background-size: 16px 16px;
            color: #1a1815;
        }

        /* Blackout Redactions */
        .blackout-redacted {
            background-color: #0d0c0f;
            color: #0d0c0f;
            padding: 0 6px;
            border-radius: 2px;
            display: inline-block;
            user-select: none;
        }

        /* Heart pulsing & damaged */
        .heart-icon {
            transition: all 0.3s ease;
        }
        .heart-damaged {
            color: #3a2222 !important;
            transform: scale(0.85);
            filter: grayscale(1);
        }

        input[type=range] {
            accent-color: #ff2233;
        }
    </style>
</head>
<body class="font-sans min-h-screen flex flex-col justify-between p-2 md:p-6 crt-overlay relative">

    <!-- Header / Title & Audio Engine Activator -->

            if (state.currentVmIndex < 0) return;
            const vm = VOICEMAILS[state.currentVmIndex];
            state.currentTime = Math.floor((val / 100) * vm.duration);
            updateScrubberUI();
        }

        function updateScrubberUI() {
            const vm = VOICEMAILS[state.currentVmIndex];
            const maxDuration = vm ? vm.duration : 100;
            const percentage = (state.currentTime / maxDuration) * 100;

            document.getElementById('scrubber').value = percentage;
            
            const mins = Math.floor(state.currentTime / 60);
            const secs = Math.floor(state.currentTime % 60);
            const formatted = `0${mins}:${secs < 10 ? '0' : ''}${secs}`;
            
            document.getElementById('current-time-text').innerText = formatted;
            document.getElementById('tape-counter').innerText = formatted;

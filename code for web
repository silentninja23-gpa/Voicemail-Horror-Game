            if (tabName === 'notebook') {
                tabNotebook.classList.remove('hidden');
                tabTranscript.classList.add('hidden');

                btnNotebook.classList.add('border-red-500', 'text-red-400');
                btnNotebook.classList.remove('border-transparent', 'text-gray-500');

                btnTranscript.classList.remove('border-red-500', 'text-red-400');
                btnTranscript.classList.add('border-transparent', 'text-gray-500');
            } else {
                tabNotebook.classList.add('hidden');
                tabTranscript.classList.remove('hidden');

                btnTranscript.classList.add('border-red-500', 'text-red-400');
                btnTranscript.classList.remove('border-transparent', 'text-gray-500');

                btnNotebook.classList.remove('border-red-500', 'text-red-400');
                btnNotebook.classList.add('border-transparent', 'text-gray-500');
            }
        }

        // Initialize App
        window.onload = function() {
            renderVoicemailList();
            renderEvidenceNotes();
            setupCanvasVisualizer();
        };
    </script>
</body>
</html>

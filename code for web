        /* ===================================================================
           WEB AUDIO API SOUND SYNTHESIZER
           =================================================================== */
        function initAudioEngine() {
            if (state.audioInitialized) return;
            try {
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                state.audioContext = new AudioCtx();
                state.audioInitialized = true;
                
                document.getElementById('audio-status-text').innerText = 'Synth Active';
                document.getElementById('audio-init-btn').classList.remove('bg-red-900/60');
                document.getElementById('audio-init-btn').classList.add('bg-emerald-900/60', 'border-emerald-600', 'text-emerald-200');

                playTapeClick();
            } catch (e) {
                console.error("Web Audio API unavailable", e);
            }
        }

        function playTapeClick() {
            if (!state.audioContext) return;
            const ctx = state.audioContext;
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();

            osc.type = 'triangle';
            osc.frequency.setValueAtTime(140, ctx.currentTime);
            osc.frequency.exponentialRampToValueAtTime(30, ctx.currentTime + 0.07);

            gain.gain.setValueAtTime(0.25, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.07);

            osc.connect(gain);
            gain.connect(ctx.destination);

            osc.start();
            osc.stop(ctx.currentTime + 0.07);
        }

        // Procedural Tape Noise / Static Generator
        let hissNode = null;
        function startTapeHiss() {
            if (!state.audioContext || hissNode || !state.hissEnabled) return;
            const ctx = state.audioContext;
            const bufferSize = ctx.sampleRate * 2;
            const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
            const output = buffer.getChannelData(0);

            for (let i = 0; i < bufferSize; i++) {
                output[i] = (Math.random() * 2 - 1) * 0.012;
            }

            hissNode = ctx.createBufferSource();
            hissNode.buffer = buffer;
            hissNode.loop = true;

            const filter = ctx.createBiquadFilter();
            filter.type = 'bandpass';
            filter.frequency.value = 1200;

            const gain = ctx.createGain();
            gain.gain.value = 0.12;

            hissNode.connect(filter);
            filter.connect(gain);
            gain.connect(ctx.destination);

            hissNode.start();
        }

        function stopTapeHiss() {
            if (hissNode) {
                try { hissNode.stop(); } catch(e){}
                hissNode = null;
            }
        }

        function playDamageSound() {
            if (!state.audioContext) return;
            const ctx = state.audioContext;
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();

            osc.type = 'sawtooth';
            osc.frequency.setValueAtTime(80, ctx.currentTime);
            osc.frequency.exponentialRampToValueAtTime(20, ctx.currentTime + 0.4);

            gain.gain.setValueAtTime(0.5, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.4);

            osc.connect(gain);
            gain.connect(ctx.destination);

            osc.start();
            osc.stop(ctx.currentTime + 0.4);
        }

        /* ===================================================================
           SPEECH SYNTHESIS ENGINE
           =================================================================== */
        function speakTranscript(textList, pitch, rate, isReverseMode = false) {
            if (!('speechSynthesis' in window)) return;

            window.speechSynthesis.cancel();

            let fullText = textList.join('. ');
            if (isReverseMode) {
                fullText = fullText.split('').reverse().join('');
            }
            
            const utterance = new SpeechSynthesisUtterance(fullText);
            utterance.pitch = pitch || 1.0;
            utterance.rate = (rate || 1.0) * state.playbackSpeed;

            const voices = window.speechSynthesis.getVoices();
            if (voices.length > 0) {
                if (pitch < 0.7) {
                    const maleVoice = voices.find(v => v.name.includes('Male') || v.name.includes('David') || v.name.includes('Google US English'));
                    if (maleVoice) utterance.voice = maleVoice;
                } else if (pitch > 1.1) {
                    const femaleVoice = voices.find(v => v.name.includes('Female') || v.name.includes('Zira'));
                    if (femaleVoice) utterance.voice = femaleVoice;
                }
            }

            window.speechSynthesis.speak(utterance);
        }


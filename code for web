            document.getElementById('reel-left').classList.remove('spinning');
            document.getElementById('reel-right').classList.remove('spinning');

            clearInterval(state.playbackInterval);
        }

        function stopAudio() {
            state.isPlaying = false;
            state.currentTime = 0;
            playTapeClick();
            stopTapeHiss();
            if ('speechSynthesis' in window) window.speechSynthesis.cancel();

            document.getElementById('deck-status').innerText = 'STOPPED';
            document.getElementById('deck-status').className = 'font-retro text-crt-amber text-lg leading-none';
            document.getElementById('play-icon').className = 'fa-solid fa-play';

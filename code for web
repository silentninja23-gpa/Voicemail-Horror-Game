            document.getElementById('play-btn-text').innerText = 'PAUSE';

            document.getElementById('reel-left').classList.add('spinning');
            document.getElementById('reel-right').classList.add('spinning');

            const linesToSpeak = (state.isReversed && vm.reverseTranscript) ? [vm.reverseTranscript] : vm.transcript;
            speakTranscript(linesToSpeak, vm.pitch, vm.rate, state.isReversed);

            if (state.isReversed && vm.hasReverseSecret) {
                document.getElementById('transcript-overlay').innerText = `"${vm.reverseTranscript}"`;
                document.getElementById('secret-signal-indicator').classList.remove('hidden');
            } else {
                document.getElementById('transcript-overlay').innerText = `"${linesToSpeak[0]}"`;
                document.getElementById('secret-signal-indicator').classList.add('hidden');
            }

            clearInterval(state.playbackInterval);
            state.playbackInterval = setInterval(() => {
                if (state.currentTime < vm.duration) {
                    state.currentTime += 1;
                    updateScrubberUI();
                } else {
                    stopAudio();
                    checkGameProgress();
                }
            }, 1000 / state.playbackSpeed);
        }

